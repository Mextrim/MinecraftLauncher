{
  "name": "minecraft-launcher-electron",
  "version": "2.0.0",
  "description": "Modern Minecraft Launcher built with Electron & Rust",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable"
  },
  "keywords": ["minecraft", "launcher", "electron", "rust"],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1"
  },
  "build": {
    "appId": "com.craftlauncher.app",
    "productName": "Minecraft Launcher",
    "win": {
      "target": "portable",
      "artifactName": "MinecraftLauncher-Electron-Rust.exe"
    },
    "extraResources": [
      {
        "from": "bin/rust-core.exe",
        "to": "bin/rust-core.exe"
      }
    ]
  }
}
